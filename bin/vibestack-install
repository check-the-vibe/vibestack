}

# Publish Godot as a repairable transaction. The catalog's convergence marker
# is removed before any public artifact changes and is atomically restored only
# after the binary, desktop entry, desktop database, and user shortcut all
# succeed. A crash or late failure can leave repairable artifacts behind, but
# it can never leave a state that the setup service mistakes for convergence.
publish_godot_install() {
  local source_binary="$1" source_desktop_entry="$2"
  local binary_destination="${3:-/usr/local/bin/godot}"
  local desktop_entry_destination="${4:-/usr/share/applications/org.godotengine.Godot.desktop}"
  local commit_path="${5:-$GODOT_COMMIT_PATH}"
  local expected_uid="${6:-0}" expected_gid="${7:-0}"
  local inject_late_failure="${8:-0}"
  local binary_parent desktop_entry_parent commit_parent marker_tmp previous_umask

  [[ "$inject_late_failure" == 0 || "$inject_late_failure" == 1 ]] || {
    say "invalid Godot publication failure-injection value"
    return 1
  }
  binary_parent="${binary_destination%/*}"
  desktop_entry_parent="${desktop_entry_destination%/*}"
  commit_parent="${commit_path%/*}"
  ensure_safe_owned_directory "$binary_parent" "$expected_uid" "$expected_gid" || return 1
  ensure_safe_owned_directory "$desktop_entry_parent" "$expected_uid" "$expected_gid" false true || return 1
  ensure_safe_owned_directory "$commit_parent" "$expected_uid" "$expected_gid" || return 1

  # An earlier successful marker must not survive a failed repair/reinstall.
  rm -f -- "$commit_path" || return 1
  [[ ! -e "$commit_path" && ! -L "$commit_path" ]] || return 1

  install -m 0755 "$source_binary" "$binary_destination" || return 1
  [[ "$(HOME="$INSTALL_TMPDIR" "$binary_destination" --version)" == \
     "${GODOT_VERSION}.stable.official."* ]] || return 1
  install -m 0644 "$source_desktop_entry" "$desktop_entry_destination" || return 1
  cmp -s -- "$source_desktop_entry" "$desktop_entry_destination" || return 1
  refresh_desktop_database "$desktop_entry_parent" || return 1
  add_shortcut org.godotengine.Godot || return 1

  if [[ "$inject_late_failure" == 1 ]]; then
    say "injected Godot late publication failure"
    return 1
  fi

  previous_umask="$(umask)"
  umask 077
  marker_tmp="$(mktemp "$commit_parent/.vibestack-godot-commit.XXXXXXXXXX")" || {
    umask "$previous_umask"
    return 1
  }
  umask "$previous_umask"
  if ! printf 'godot %s\n' "$GODOT_VERSION" > "$marker_tmp" ||
     ! chmod 0644 "$marker_tmp" ||
     ! mv -Tf -- "$marker_tmp" "$commit_path"; then
    rm -f -- "$marker_tmp"
    return 1
  fi
  [[ "$(stat -c '%F:%u:%g:%a' -- "$commit_path")" == \
     "regular file:${expected_uid}:${expected_gid}:644" ]] || {
    rm -f -- "$commit_path"
    return 1
  }
  [[ "$(cat -- "$commit_path")" == "godot ${GODOT_VERSION}" ]] || {
    rm -f -- "$commit_path"
    return 1
  }
}

install_godot() {
  local architecture godot_arch expected_sha expected_machine
  local archive_name archive_path binary_name binary_path installed_version
  local desktop_entry

  architecture="$(dpkg --print-architecture)" || return 1
  case "$architecture" in
    amd64)
      godot_arch=x86_64
      expected_sha="$GODOT_SHA256_X64"
      expected_machine=62
      ;;
    arm64)
      godot_arch=arm64
      expected_sha="$GODOT_SHA256_ARM64"
      expected_machine=183
      ;;
    *)
      say "Godot ${GODOT_VERSION} is unsupported on architecture: ${architecture}"
      return 1
      ;;
  esac

  archive_name="Godot_v${GODOT_VERSION}-stable_linux.${godot_arch}.zip"
  binary_name="${archive_name%.zip}"
  say "downloading pinned Godot ${GODOT_VERSION} for ${architecture}"
  download_private_file \
    "https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}-stable/${archive_name}" \
    "$archive_name" archive_path 134217728 1200 || return 1
  printf '%s  %s\n' "$expected_sha" "$archive_path" | sha256sum -c - || {
    say "Godot archive checksum did not match; aborting"
    return 1
  }
  extract_godot_archive \
    "$archive_path" "$binary_name" "$expected_machine" binary_path || return 1
  installed_version="$(HOME="$INSTALL_TMPDIR" "$binary_path" --version)" || return 1
  [[ "$installed_version" == "${GODOT_VERSION}.stable.official."* ]] || {
    say "Godot version mismatch: expected ${GODOT_VERSION}.stable.official, got ${installed_version}"
    return 1
  }

  desktop_entry="$INSTALL_TMPDIR/org.godotengine.Godot.desktop"
  printf '%s\n' \
    '[Desktop Entry]' \
    'Version=1.0' \
    'Type=Application' \
    'Name=Godot Engine' \
    'GenericName=Libre game engine' \
    'Comment=Multi-platform 2D and 3D game engine with a feature-rich editor' \
    'Keywords=game development;development;IDE;game engine;' \
    'Exec=/usr/local/bin/godot --rendering-method gl_compatibility --audio-driver Dummy %f' \
    'TryExec=/usr/local/bin/godot' \
    'Icon=applications-development' \
    'Terminal=false' \
    'MimeType=application/x-godot-project;' \
    'Categories=Development;IDE;' \
    'StartupNotify=true' \
    'StartupWMClass=Godot' \
    'OnlyShowIn=XFCE;' > "$desktop_entry" || return 1
  desktop-file-validate "$desktop_entry" || return 1
  publish_godot_install "$binary_path" "$desktop_entry"
}

install_flatpak() {
  local -a flatpak_env=(
    HOME=/home/vibe
    USER=vibe
    LOGNAME=vibe
    PATH=/usr/local/bin:/usr/bin:/bin
    XDG_DATA_HOME=/home/vibe/.local/share
    XDG_RUNTIME_DIR=/run/vibestack/runtime
  )
  local marker_metadata
  marker_metadata="$(
    stat -c '%u:%g:%a:%h' -- \
      /run/vibestack/host/flatpak-enabled 2>/dev/null || true
  )"
  if [[ ! -f /run/vibestack/host/flatpak-enabled ||
        -L /run/vibestack/host/flatpak-enabled ||
        "$marker_metadata" != '0:0:444:1' ]]; then
    say "Flatpak requires a container started with ./startup.sh --flatpak"
    return 1
  fi
  apt_install flatpak xdg-desktop-portal xdg-desktop-portal-xapp || return 1
  /usr/sbin/runuser -u vibe -- /usr/bin/env "${flatpak_env[@]}" \
    /usr/local/bin/vibestack-flatpak check >/dev/null || {
      say "nested Flatpak sandbox preflight failed; verify the --flatpak Docker mode"
      return 1
    }
  /usr/sbin/runuser -u vibe -- /usr/bin/env "${flatpak_env[@]}" \
    /usr/local/bin/vibestack-flatpak _ensure-flathub || return 1
  add_shortcut vibestack-flathub || return 1
  add_shortcut vibestack-flatpak
}

install_build_essential() {
  apt_install build-essential || return 1
}

install_editors() {
  apt_install mousepad geany meld vim || return 1
  su - vibe -c 'git config --global diff.tool meld;
                git config --global merge.tool meld;
                git config --global difftool.prompt false' || return 1
  add_shortcut geany || return 1
  add_shortcut org.gnome.Meld
}

install_images() {
  apt_install gimp drawing flameshot || return 1
  add_shortcut gimp || return 1
}

dispatch() {
  case "$1" in
    node)           install_node ;;
    claude-code)    install_claude_code ;;
    codex-cli)      install_codex_cli ;;
    opencode)       install_opencode ;;
    chrome)         install_chrome ;;
    claude-desktop) install_claude_desktop ;;
    chatgpt)        install_chatgpt ;;
    godot)          install_godot ;;
    flatpak)        install_flatpak ;;
    build-essential) install_build_essential ;;
    editors)        install_editors ;;
    images)         install_images ;;
    *) say "unknown component: $1"; return 1 ;;
  esac
}

# Expand requires and order the work using the catalog.
acquire_install_lock "$INSTALL_LOCK_PATH" 0 0 || exit 1
if ! ORDERED="$(VIBESTACK_CATALOG="$CATALOG" /usr/bin/python3 -I - "$@" <<'PY'
# COMPONENT_RESOLVER_BEGIN
import sys
sys.path.insert(0, "/usr/share/vibestack")
import setuplib as lib
catalog = lib.load_catalog()
requested = sys.argv[1:]
known = {component["id"] for component in catalog["components"]}
unknown = [component_id for component_id in requested if component_id not in known]
if unknown:
    print("unknown component(s): " + " ".join(unknown), file=sys.stderr)
    raise SystemExit(2)
print(" ".join(lib.resolve(catalog, requested)))
# COMPONENT_RESOLVER_END
PY
)"; then
  say "component resolution failed"
  exit 1
fi
[[ -n "$ORDERED" ]] || { say "nothing to do"; exit 0; }
read -r -a ordered_ids <<<"$ORDERED"

failed=()
for id in "${ordered_ids[@]}"; do
  case "$id" in
    node|claude-code|codex-cli|opencode|chrome|claude-desktop|chatgpt|godot|flatpak|build-essential|editors|images) ;;
    *) say "resolver returned unknown privileged component: $id"; exit 1 ;;
  esac
  say "=== $id ==="
  if dispatch "$id"; then
    say "$id ok"
  else
    say "$id FAILED"
    failed+=("$id")
  fi
done

apt-get clean; rm -rf /var/lib/apt/lists/*

if ((${#failed[@]})); then
  say "failed: ${failed[*]}"
  exit 1
fi
say "all components installed"
