#!/usr/bin/python3
"""Render local workspace identity as an XFCE wallpaper, without reading secrets."""
import argparse
import json
import os
from pathlib import Path
import re
import socket
import subprocess
from urllib.parse import urlsplit


def label(value, default='Not published', maximum=100):
    if not isinstance(value, str):
        return default
    value=' '.join(value.split())
    return value[:maximum] if value else default


def metadata(environ):
    name=label(environ.get('VIBESTACK_INSTANCE_NAME'), socket.gethostname(), 64)
    ports={}
    for title,key,default in [('WEB','VIBESTACK_PUBLIC_PORT','80'),('SSH','VIBESTACK_SSH_PORT','22'),('VNC','VIBESTACK_NATIVE_VNC_PORT','5901')]:
        value=environ.get(key,default)
        ports[title]=str(int(value)) if isinstance(value,str) and len(value) <= 5 and value.isdecimal() and 0 < int(value) <= 65535 else 'Not published'
    origin=''
    raw=environ.get('VIBESTACK_PUBLIC_URL','')
    try:
        url=urlsplit(raw)
        if url.scheme in ('http','https') and url.hostname and not url.username and not url.password:
            # Exclude credentials, URL path, query, and fragment even if misconfigured.
            host=url.hostname
            host='['+host+']' if ':' in host else host
            origin=f'{url.scheme}://{host}'+(f':{url.port}' if url.port else '')
    except ValueError:
        pass
    return {'name':name,'origin':label(origin,'Open through your host or private tailnet',120),'ports':ports}


def render(info, output, width=1920, height=1200):
    from PIL import Image, ImageDraw, ImageFont
    scale=min(width/1920,height/1200)
    image=Image.new('RGB',(width,height)); draw=ImageDraw.Draw(image)
    for y in range(height):
        t=y/max(1,height-1)
        draw.line((0,y,width,y),fill=(int(13+4*t),int(17+5*t),int(25+8*t)))
    x=int(width*.17); y=int(height*.28)
    def font(size,bold=False):
        name='DejaVuSans-Bold.ttf' if bold else 'DejaVuSans.ttf'
        return ImageFont.truetype('/usr/share/fonts/truetype/dejavu/'+name,max(12,int(size*scale)))
    def text(value,top,size,color,bold=False):
        f=font(size,bold)
        while draw.textbbox((0,0),value,font=f)[2] > width-x-int(width*.1) and len(value)>5:
            value=value[:-2].rstrip('…')+'…'
        draw.text((x,top),value,font=f,fill=color)
    accent=(225,129,96); muted=(144,158,179); white=(230,236,246)
    draw.rounded_rectangle((x,y-int(64*scale),x+int(40*scale),y-int(24*scale)),radius=int(10*scale),fill=accent)
    text('V I B E S T A C K',y,20,accent,True)
    text(info['name'],y+int(50*scale),60,white,True)
    text(info['origin'],y+int(139*scale),25,muted)
    line=y+int(211*scale)
    draw.line((x,line,width-int(width*.16),line),fill=(44,55,72),width=1)
    for index,(title,value) in enumerate(info['ports'].items()):
        px=x+int(index*300*scale)
        draw.text((px,line+int(36*scale)),title+' PORT',font=font(15,True),fill=muted)
        draw.text((px,line+int(71*scale)),value,font=font(30),fill=white)
    text('PROJECTS   /projects',line+int(148*scale),20,muted)
    text('Desktop  ·  Terminal  ·  Editor  ·  Settings',height-int(104*scale),18,muted)
    output.parent.mkdir(parents=True,exist_ok=True)
    temporary=output.with_suffix('.tmp.png'); image.save(temporary); os.replace(temporary,output)


def apply(output):
    command=['xfconf-query','--channel','xfce4-desktop']
    result=subprocess.run(command+['--list'],capture_output=True,text=True,check=True)
    roots={path.rsplit('/',1)[0] for path in result.stdout.splitlines() if re.fullmatch(r'/backdrop/screen\d+/monitor[^/]+/workspace\d+/[^/]+',path)}
    if not roots:
        roots={'/backdrop/screen0/monitor0/workspace0'}
    for root in sorted(roots):
        for key,kind,value in [('last-image','string',str(output)),('image-style','int','4'),('cycle-enable','bool','false')]:
            subprocess.run(command+['--property',root+'/'+key,'--create','--type',kind,'--set',value],check=True,capture_output=True)


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output',type=Path,default=Path('/run/vibestack/runtime/wallpaper.png'))
    parser.add_argument('--apply',action='store_true')
    args=parser.parse_args()
    info=metadata(os.environ)
    # Explicit public metadata file supports a development patch on existing containers.
    path=Path('/run/vibestack/workspace-info.json')
    if path.is_file() and path.stat().st_size < 4096:
        try:
            overrides=json.loads(path.read_text())
            info=metadata({**os.environ,**{k:v for k,v in overrides.items() if k in {'VIBESTACK_INSTANCE_NAME','VIBESTACK_PUBLIC_URL','VIBESTACK_PUBLIC_PORT','VIBESTACK_SSH_PORT','VIBESTACK_NATIVE_VNC_PORT'}}})
        except (ValueError,TypeError,AttributeError):
            pass
    render(info,args.output)
    if args.apply: apply(args.output)


if __name__=='__main__': main()
