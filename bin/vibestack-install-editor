#!/usr/bin/env bash
# Build-time installation of the pinned core editor; no service/session startup.
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo 'Core editor installation requires root.' >&2; exit 1; }
export DEBIAN_FRONTEND=noninteractive
version=4.136.2
architecture="$(dpkg --print-architecture)"
case "$architecture" in
  amd64) checksum=607967f576db28f2cf54c6f828670cb7d4cb542876356c9f3fa05f3871c7bc97 ;;
  arm64) checksum=ca4fa6633026c29b13633febee523dce581bab717265ff68af5f79f2d3ac9806 ;;
  *) echo 'Unsupported core editor architecture.' >&2; exit 1 ;;
esac
umask 077
editor_tmp="$(mktemp -d /tmp/vibestack-core-editor.XXXXXXXX)"
trap 'rm -rf -- "$editor_tmp"' EXIT
package="$editor_tmp/editor.deb"
curl --fail --show-error --silent --location --proto '=https' --proto-redir '=https' --retry 3 --connect-timeout 30 --max-time 1200 --max-filesize 268435456 \
  "https://github.com/coder/code-server/releases/download/v${version}/code-server_${version}_${architecture}.deb" -o "$package"
printf '%s  %s\n' "$checksum" "$package" | sha256sum -c -
[[ "$(dpkg-deb -f "$package" Package)" == code-server ]]
[[ "$(dpkg-deb -f "$package" Version)" == "$version" ]]
[[ "$(dpkg-deb -f "$package" Architecture)" == "$architecture" ]]
apt-get update
apt-get install -y --no-install-recommends "$package"
code-server --version | grep -Eq '^4[.]136[.]2([[:space:]]|$)'
