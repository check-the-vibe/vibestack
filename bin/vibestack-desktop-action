#!/usr/bin/env bash
# Safe, fixed-surface launch actions used by VibeStack's XFCE menu.
set -euo pipefail
umask 027

readonly DEFAULT_PROJECTS_DIR=/projects
readonly DEFAULT_LOG_ROOT=/data/logs/vibestack
readonly ACTION_LOG_RELATIVE=desktop/actions.jsonl
readonly ACTION_LOG_MAX_BYTES=1048576
readonly AGENT_GUIDE=/usr/share/doc/vibestack/AGENTS.md
readonly AUTOMATION_GUIDE=/usr/share/doc/vibestack/AUTOMATION.md
readonly FLATHUB_URL=https://flathub.org
readonly SETUP_URL='http://127.0.0.1/setup/?force=1'
readonly STATUS_URL=http://127.0.0.1/api/v1/status
readonly SELF="$(readlink -f "${BASH_SOURCE[0]}")"

usage() {
  cat >&2 <<'USAGE'
usage: vibestack-desktop-action ACTION

Actions:
  projects          open /projects
  workspace-desktop show the graphical desktop
  editor            open the browser editor or its installer
  desktop           open the desktop folder
  logs              open persistent VibeStack logs
  setup             open setup and onboarding
  agent-guide       open the local VibeStack agent guide
  automation-guide  open the local automation guide
  flathub           browse the stable Flathub marketplace
  flatpak           open a terminal for per-user Flatpak management
  flatpak-ref FILE  review and install a downloaded stable-Flathub reference
  flatpak-url URL   review and install a stable-Flathub application link
  service-status    show service state in a terminal
  settings          open XFCE settings
  terminal          open a terminal in /projects
  file-manager      open the home folder
  screenshot        save a timestamped desktop screenshot
  coding TOOL       start claude, codex, or opencode in /projects
USAGE
}

load_session_environment() {
  local session_file
  # The /tmp file is a transition fallback for images built before the
  # runtime state moved to the root-owned /run/vibestack directory.
  for session_file in /run/vibestack/session.env /tmp/vibestack-session.env; do
    if [[ -r "$session_file" ]]; then
      # This file is produced by VibeStack's own XFCE startup script and only
      # contains exported desktop-session values.
      # shellcheck disable=SC1090
      source "$session_file"
      break
    fi
  done

  export DISPLAY="${DISPLAY:-:0}"
  if [[ -z "${XAUTHORITY:-}" && -r /run/vibestack/Xauthority ]]; then
    export XAUTHORITY=/run/vibestack/Xauthority
  fi
  if [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
    if [[ -d "/run/user/$(id -u)" ]]; then
      export XDG_RUNTIME_DIR="/run/user/$(id -u)"
    else
      export XDG_RUNTIME_DIR="/tmp/runtime-${USER:-vibe}"
    fi
  fi
  export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-XFCE}"
  export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-x11}"
}

log_action() {
  local outcome="$1"
  local log_root="${VIBESTACK_LOGS_DIR:-$DEFAULT_LOG_ROOT}"
  local log_file="$log_root/$ACTION_LOG_RELATIVE"
  [[ -d "$log_root" ]] || return 0
  mkdir -p "$(dirname "$log_file")" 2>/dev/null || return 0
  command -v flock >/dev/null 2>&1 || return 0
  (
    flock --exclusive --wait 2 9 || exit 0
    if [[ -f "$log_file" ]] && (( $(stat --format=%s "$log_file" 2>/dev/null || printf 0) >= ACTION_LOG_MAX_BYTES )); then
      [[ ! -f "$log_file.1" ]] || mv -f "$log_file.1" "$log_file.2"
      mv -f "$log_file" "$log_file.1"
    fi
    printf '{"timestamp":"%s","source":"%s","action":"%s","outcome":"%s"}\n' \
      "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "${LOG_SOURCE:-xfce-menu}" \
      "$LOG_ACTION" "$outcome" \
      >> "$log_file"
  ) 9>> "$log_file.lock" 2>/dev/null || true
}

log_result_on_exit() {
  local status=$?
  if (( status == 0 )); then
    log_action launched
  else
    log_action failed
  fi
}

launch_background() {
  local executable="$1"
  if [[ "$executable" == */* ]]; then
    [[ -x "$executable" ]] || return 127
  else
    command -v "$executable" >/dev/null 2>&1 || return 127
  fi
  nohup "$@" >/dev/null 2>&1 &
}

open_directory() {
  local directory="$1"
  [[ -d "$directory" ]] || {
    printf 'VibeStack directory is unavailable: %s\n' "$directory" >&2
    return 1
  }
  if command -v thunar >/dev/null 2>&1; then
    launch_background thunar "$directory"
  elif command -v xdg-open >/dev/null 2>&1; then
    launch_background xdg-open "$directory"
  else
    printf 'No file manager is installed.\n' >&2
    return 127
  fi
}

launch_terminal_command() {
  local title="$1" hold="$2"
  shift 2
  local -a arguments=(xfce4-terminal "--title=$title" "--working-directory=${VIBESTACK_PROJECTS_DIR:-$DEFAULT_PROJECTS_DIR}")
  [[ "$hold" == true ]] && arguments+=(--hold)
  arguments+=(--execute "$@")
  launch_background "${arguments[@]}"
}

open_url() {
  local url="$1" browser
  for browser in google-chrome-stable chromium chromium-browser; do
    if type -P "$browser" >/dev/null 2>&1; then
      if [[ -x /usr/local/bin/vibestack-app ]]; then
        launch_background /usr/local/bin/vibestack-app "$(type -P "$browser")" "$url"
      else
        launch_background "$(type -P "$browser")" "$url"
      fi
      return
    fi
  done
  if type -P firefox >/dev/null 2>&1; then
    launch_background "$(type -P firefox)" "$url"
  elif command -v exo-open >/dev/null 2>&1; then
    # Uses whatever browser is registered with XFCE and presents XFCE's
    # preferred-application chooser when none has been selected yet.
    launch_background exo-open --launch WebBrowser "$url"
  elif command -v xdg-open >/dev/null 2>&1; then
    launch_background xdg-open "$url"
  else
    printf 'No graphical browser is installed. Open %s from the VibeStack shell.\n' "$url" >&2
    return 127
  fi
}

open_document() {
  local title="$1" document="$2"
  [[ -f "$document" ]] || return 1
  if type -P mousepad >/dev/null 2>&1; then
    launch_background "$(type -P mousepad)" "$document"
  elif type -P geany >/dev/null 2>&1; then
    launch_background "$(type -P geany)" "$document"
  elif type -P nano >/dev/null 2>&1; then
    launch_terminal_command "$title" false "$(type -P nano)" --view "$document"
  else
    launch_terminal_command "$title" true /usr/bin/sed -n 1,320p "$document"
  fi
}

pretty_get() {
  local url="$1"
  if ! command -v curl >/dev/null 2>&1; then
    printf 'curl is unavailable; cannot query %s\n' "$url" >&2
    return 127
  fi
  if command -v python3 >/dev/null 2>&1; then
    curl --fail --silent --show-error --max-time 5 "$url" | python3 -m json.tool
  else
    curl --fail --silent --show-error --max-time 5 "$url"
    printf '\n'
  fi
}

print_status() {
  printf 'VibeStack service status\n\n'
  pretty_get "$STATUS_URL" || {
    printf '\nThe control API is not responding at %s\n' "$STATUS_URL" >&2
    return 1
  }
}

print_missing_automation_guide() {
  printf 'The VibeStack automation guide is not installed at:\n\n  %s\n\n' "$AUTOMATION_GUIDE"
  printf 'Rebuild the image with the packaged guide, or read the API documentation from the host checkout.\n'
}

take_screenshot() {
  local screenshot_dir="${VIBESTACK_SCREENSHOT_DIR:-$HOME/Desktop/Screenshots}"
  local screenshot_file
  command -v scrot >/dev/null 2>&1 || {
    printf 'scrot is not installed.\n' >&2
    return 127
  }
  mkdir -p "$screenshot_dir"
  screenshot_file="$screenshot_dir/VibeStack-$(date '+%Y-%m-%d_%H-%M-%S')-$$.png"
  scrot "$screenshot_file"
  printf 'Screenshot saved to %s\n' "$screenshot_file"
  if command -v notify-send >/dev/null 2>&1; then
    launch_background notify-send 'VibeStack screenshot saved' "$screenshot_file" || true
  fi
}

launch_coding_tool() {
  local tool="$1" label binary
  case "$tool" in
    claude)   label='Claude Code' ;;
    codex)    label='Codex CLI' ;;
    opencode) label='OpenCode' ;;
    *) printf 'Unsupported coding tool: %s\n' "$tool" >&2; return 2 ;;
  esac
  binary="$(type -P "$tool")" || {
    printf '%s is not installed. Add it from Setup & Onboarding.\n' "$label" >&2
    return 127
  }
  launch_terminal_command "$label" false "$binary"
}

action="${1:-}"
shift || true

# Private display commands are invoked by the terminal launchers above. They
# intentionally do not create a second menu audit record.
case "$action" in
  _print-status)
    load_session_environment
    print_status
    exit
    ;;
  _print-missing-automation-guide)
    load_session_environment
    print_missing_automation_guide
    exit
    ;;
esac

case "$action" in
  projects|desktop|workspace-desktop|editor|logs|setup|agent-guide|automation-guide|flathub|flatpak|service-status|settings|terminal|file-manager|screenshot)
    [[ $# -eq 0 ]] || { usage; exit 2; }
    LOG_ACTION="$action"
    ;;
  coding)
    [[ $# -eq 1 ]] || { usage; exit 2; }
    case "$1" in
      claude|codex|opencode) LOG_ACTION="coding-$1" ;;
      *) usage; exit 2 ;;
    esac
    ;;
  flatpak-ref)
    [[ $# -eq 1 ]] || { usage; exit 2; }
    LOG_ACTION=flatpak-ref
    LOG_SOURCE=desktop-mime
    ;;
  flatpak-url)
    [[ $# -eq 1 ]] || { usage; exit 2; }
    LOG_ACTION=flatpak-url
    LOG_SOURCE=desktop-mime
    ;;
  *)
    usage
    exit 2
    ;;
esac

load_session_environment
trap log_result_on_exit EXIT

case "$action" in
  projects)
    open_directory "${VIBESTACK_PROJECTS_DIR:-$DEFAULT_PROJECTS_DIR}"
    ;;
  workspace-desktop)
    wmctrl -k on
    ;;
  editor)
    open_url 'http://127.0.0.1/vnc/?view=editor'
    ;;
  desktop)
    mkdir -p "$HOME/Desktop"
    open_directory "$HOME/Desktop"
    ;;
  logs)
    open_directory "${VIBESTACK_LOGS_DIR:-$DEFAULT_LOG_ROOT}"
    ;;
  setup)
    open_url "$SETUP_URL"
    ;;
  agent-guide)
    if [[ -f "$AGENT_GUIDE" ]]; then
      open_document "VibeStack Agent Guide" "$AGENT_GUIDE"
    else
      launch_terminal_command "VibeStack Agent Guide" true /usr/bin/printf \
        'The VibeStack agent guide is not installed at %s\n' "$AGENT_GUIDE"
    fi
    ;;
  automation-guide)
    if [[ -f "$AUTOMATION_GUIDE" ]]; then
      open_document "VibeStack Automation Guide" "$AUTOMATION_GUIDE"
    else
      launch_terminal_command "VibeStack Automation Guide" true "$SELF" _print-missing-automation-guide
    fi
    ;;
  flathub)
    open_url "$FLATHUB_URL"
    ;;
  flatpak)
    launch_terminal_command "Manage Flatpak Apps" false /bin/bash -lc \
      '/usr/local/bin/vibestack-flatpak status || true; printf "\nUse vibestack-flatpak help for commands.\n"; exec bash'
    ;;
  flatpak-ref)
    launch_terminal_command "Install Flatpak Application" true \
      /usr/local/bin/vibestack-flatpak install-ref "$1"
    ;;
  flatpak-url)
    launch_terminal_command "Install Flatpak Application" true \
      /usr/local/bin/vibestack-flatpak install-url "$1"
    ;;
  service-status)
    launch_terminal_command "VibeStack Service Status" true "$SELF" _print-status
    ;;
  settings)
    launch_background xfce4-settings-manager
    ;;
  terminal)
    launch_background xfce4-terminal "--working-directory=${VIBESTACK_PROJECTS_DIR:-$DEFAULT_PROJECTS_DIR}"
    ;;
  file-manager)
    open_directory "$HOME"
    ;;
  screenshot)
    take_screenshot
    ;;
  coding)
    launch_coding_tool "$1"
    ;;
esac
