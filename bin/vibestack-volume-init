#!/usr/bin/env python3
"""Initialize only the roots of fresh runner-managed named volumes."""

import os
import pwd
import stat
import sys


def main():
    if os.geteuid() != 0:
        raise RuntimeError("volume initialization requires root")
    account = pwd.getpwnam("vibe")
    for path in ("/data", "/projects"):
        info = os.lstat(path)
        if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
            raise RuntimeError("managed volume root is unsafe")
    marker = "/data/.vibestack-state-v1"
    os.makedirs(marker, mode=0o755, exist_ok=True)
    marker_info = os.lstat(marker)
    if not stat.S_ISDIR(marker_info.st_mode) or stat.S_ISLNK(marker_info.st_mode):
        raise RuntimeError("managed state marker is unsafe")
    os.chown("/data", 0, account.pw_gid)
    os.chmod("/data", 0o1770)
    os.chown("/projects", account.pw_uid, account.pw_gid)
    os.chmod("/projects", 0o755)
    os.chown(marker, 0, 0)
    os.chmod(marker, 0o755)


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:
        print("[volume-init] %s" % exc, file=sys.stderr)
        raise SystemExit(1)
