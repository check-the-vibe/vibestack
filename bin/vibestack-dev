#!/usr/bin/env bash
# Host-side development helper. This file is not copied into the image.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IMAGE_NAME="${VIBESTACK_IMAGE:-vibestack:dev}"
CONTAINER_NAME="${VIBESTACK_CONTAINER:-vibestack}"
HOST_PORT="${VIBESTACK_PORT:-8080}"
ACCEPTANCE_PORT="${VIBESTACK_ACCEPTANCE_PORT:-18080}"
ACCEPTANCE_RESTORE_TIMEOUT_SECONDS="${VIBESTACK_ACCEPTANCE_RESTORE_TIMEOUT_SECONDS:-3600}"
TAILSCALE_HTTPS_PORT="${VIBESTACK_TAILSCALE_HTTPS_PORT:-9443}"
PIDS_LIMIT="${VIBESTACK_PIDS_LIMIT:-1024}"

usage() {
  cat <<'EOF'
Usage: bin/vibestack-dev COMMAND [ARG]

  test                  Run fast source/unit checks (no container required)
  build [IMAGE]         Build the development image
  accept [IMAGE]        Test an image in a disposable container, including UI
  browser [BASE_URL]    Run Playwright against an already-running VibeStack
  check                 Run non-mutating in-container checks on the live container
  status                Show container, HTTP health, and Tailscale Serve status
  logs [NAME]           Tail container logs, or one named persistent log
  shell                 Open a shell as the vibe user in the live container
  serve [HTTPS_PORT]    Privately proxy the loopback HTTP port with Tailscale

Configuration is read from VIBESTACK_* environment variables; see .env.example.
EOF
}

require() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "missing required command: $1" >&2
    exit 1
  }
}

run_fast_tests() {
  require python3
  require node
  require go
  (
    cd "$REPO_ROOT"
    python3 -m unittest discover -s tests -v
    go test ./...
    node --check desktop/app.js
    node --check desktop/launcher.js
    node --check desktop/service-worker.js
    node --check desktop/walkthrough.js
    node --check web/public/auth.js
    node --check web/public/connect.js
    node --check tests/capability-parity-check.mjs
    node --check tests/mcp-recovery-check.mjs
    node --check tests/provider-runtime-check.mjs
    node --check tests/extension-client-check.mjs
    node --check tests/rollback-check.mjs
    node --test tests/walkthrough-privacy.test.mjs
    python3 -m py_compile \
      automation/automationlib.py automation/server.py automation/sshkeys.py \
      common/vibestack_auth.py common/vibestack_hosts.py \
      bin/vibestack-api-token bin/vibestack-automation-check bin/vibestack-bootstrap \
      bin/vibestack-control bin/vibestack-password bin/vibestack-setup \
      control/server.py control/walkthrough.py proxy/websockify_auth.py setup/server.py setup/setuplib.py \
      bin/vibestack-wallpaper bin/vibestack-walkthrough \
      tests/runtime_onboarding_check.py tests/provider-persistence-check.py \
      tests/extension-authoring-check.py
    bash -n bin/vibestack-app bin/vibestack-check bin/vibestack-desktop-action bin/vibestack-dev \
      bin/vibestack-flatpak \
      bin/vibestack-healthcheck bin/vibestack-install bin/vibestack-persist \
      bin/vibestack-volume-init bin/vibestack-welcome cli.sh \
      packaging/install-runner.sh startup.sh xfce-startup entrypoint.sh
    python3 -m json.tool desktop/manifest.webmanifest >/dev/null
    python3 -m json.tool api/workspace.openapi.json >/dev/null
    python3 -m json.tool api/runner.openapi.json >/dev/null
    python3 -m json.tool api/command-coverage.json >/dev/null
    python3 -m json.tool contracts/launch-v1.json >/dev/null
    python3 -m json.tool release-manifest.json >/dev/null
    python3 -m json.tool .devcontainer/devcontainer.json >/dev/null
    python3 -m py_compile .devcontainer/codespaces.py
    git diff --check HEAD
  )
}

run_browser_tests() {
  local base_url="${1:-http://127.0.0.1:${HOST_PORT}}"
  require npm
  [[ -d "$REPO_ROOT/node_modules/@playwright/test" ]] || {
    echo "browser dependencies are missing; run: npm ci" >&2
    exit 1
  }
  (cd "$REPO_ROOT" && \
    VIBESTACK_BASE_URL="$base_url" \
    VIBESTACK_ALLOW_MUTATING_BROWSER_TESTS=0 npm run test:browser)
}

wait_for_health() {
  local container="$1"
  local attempt health
  for attempt in $(seq 1 60); do
    health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$container")"
    case "$health" in
      healthy) return 0 ;;
      unhealthy)
        docker logs --tail 200 "$container" >&2
        return 1 ;;
    esac
    sleep 2
  done
  docker logs --tail 200 "$container" >&2
  echo "container did not become healthy" >&2
  return 1
}

run_acceptance() (
  local image="${1:-$IMAGE_NAME}"
  local acceptance_container="vibestack-acceptance-$$"
  local acceptance_data="" acceptance_password_dir="" acceptance_password_file="" project_owner
  umask 077
  cleanup_acceptance() {
    local exit_status=$?
    local cleanup_dir="$acceptance_data" cleanup_password_dir="$acceptance_password_dir"
    acceptance_data=""
    acceptance_password_dir=""
    if (( exit_status != 0 )) && docker inspect "$acceptance_container" >/dev/null 2>&1; then
      echo "acceptance container diagnostics ($acceptance_container)" >&2
      docker inspect --format \
        'status={{.State.Status}} exit={{.State.ExitCode}} health={{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' \
        "$acceptance_container" >&2 || true
      docker exec "$acceptance_container" \
        supervisorctl -c /etc/supervisor/supervisord.conf status >&2 || true
      docker logs --tail 300 "$acceptance_container" >&2 || true
      local service
      for service in ssh native-vnc; do
        echo "acceptance service log: $service (last 80 lines, at most 64 KiB)" >&2
        docker exec "$acceptance_container" \
          tail -c 65536 "/data/logs/vibestack/services/$service.log" 2>&1 |
          tail -n 80 >&2 || true
      done
    fi
    docker rm -f "$acceptance_container" >/dev/null 2>&1 || true
    if [[ "$cleanup_dir" =~ ^/tmp/vibestack-acceptance\.[A-Za-z0-9]{10}$ &&
          -d "$cleanup_dir" && ! -L "$cleanup_dir" ]]; then
      # Bootstrap deliberately leaves the bind root and protected log
      # directories root-owned. Use this already-validated image only to hand
      # the exact disposable tree back to the invoking host UID before removal.
      if docker run --rm --pids-limit=512 --entrypoint /usr/bin/chown \
          -v "$cleanup_dir:/cleanup" "$image" \
          -R "$(id -u):$(id -g)" /cleanup >/dev/null 2>&1; then
        rm -rf -- "$cleanup_dir"
      else
        echo "acceptance cleanup could not reclaim $cleanup_dir" >&2
      fi
    elif [[ -n "$cleanup_dir" ]]; then
      echo "refusing unexpected acceptance cleanup path: $cleanup_dir" >&2
    fi
    if [[ "$cleanup_password_dir" =~ ^/tmp/vibestack-acceptance-password\.[A-Za-z0-9]{10}$ &&
          -d "$cleanup_password_dir" && ! -L "$cleanup_password_dir" ]]; then
      rm -rf -- "$cleanup_password_dir"
    elif [[ -n "$cleanup_password_dir" ]]; then
      echo "refusing unexpected password cleanup path: $cleanup_password_dir" >&2
    fi
    return "$exit_status"
  }
  trap cleanup_acceptance EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  require docker
  require openssl
  [[ "$PIDS_LIMIT" =~ ^[0-9]+$ ]] && (( PIDS_LIMIT >= 128 && PIDS_LIMIT <= 4096 )) || {
    echo "invalid VIBESTACK_PIDS_LIMIT: $PIDS_LIMIT" >&2
    return 2
  }
  [[ "$ACCEPTANCE_RESTORE_TIMEOUT_SECONDS" =~ ^[0-9]+$ ]] &&
    (( ACCEPTANCE_RESTORE_TIMEOUT_SECONDS >= 60 && ACCEPTANCE_RESTORE_TIMEOUT_SECONDS <= 7200 )) || {
      echo "invalid VIBESTACK_ACCEPTANCE_RESTORE_TIMEOUT_SECONDS: $ACCEPTANCE_RESTORE_TIMEOUT_SECONDS" >&2
      return 2
    }
  docker image inspect "$image" >/dev/null
  acceptance_data="$(mktemp -d /tmp/vibestack-acceptance.XXXXXXXXXX)"
  acceptance_password_dir="$(mktemp -d /tmp/vibestack-acceptance-password.XXXXXXXXXX)"
  acceptance_password_file="$acceptance_password_dir/password"
  chmod 0700 "$acceptance_password_dir"
  openssl rand -out "$acceptance_password_file" -hex 24
  chmod 0600 "$acceptance_password_file"
  mkdir -p "$acceptance_data/.vibestack-state-v1" "$acceptance_data/projects"
  # Desktop tools need to traverse /projects even when the host UID differs.
  # Preserve the fixture's nested host ownership.
  chmod 0755 "$acceptance_data/.vibestack-state-v1" "$acceptance_data/projects"
  touch "$acceptance_data/projects/ownership-sentinel"
  project_owner="$(stat -c '%u:%g' "$acceptance_data/projects/ownership-sentinel")"
  start_acceptance_container() {
    docker run -d --name "$acceptance_container" --hostname vibestack \
      --shm-size=1g --pids-limit="$PIDS_LIMIT" \
      -e VIBESTACK_FLATPAK_ENABLED=1 \
      --security-opt seccomp=unconfined \
      --security-opt apparmor=unconfined \
      --security-opt systempaths=unconfined \
      -p "127.0.0.1:${ACCEPTANCE_PORT}:80" \
      -v "$acceptance_data:/data" \
      -v "$acceptance_data/projects:/projects" \
      "$image" >/dev/null
  }
  copy_onboarding_probe() {
    docker cp "$REPO_ROOT/tests/runtime_onboarding_check.py" \
      "$acceptance_container:/tmp/vibestack-runtime-onboarding-check.py"
  }

  start_acceptance_container
  wait_for_health "$acceptance_container"
  # The file/command API deliberately requires its configured root to belong
  # to vibe. GitHub's runner UID is different; prepare only this disposable
  # mount root. Never recursively adopt its host-owned sentinel or contents.
  docker exec "$acceptance_container" chown vibe:vibe /projects
  docker exec -u vibe "$acceptance_container" vibestack-service credential create \
    --label disposable-acceptance --owner --expires-in 4h \
    --output /data/vibestack/acceptance-owner.token
  docker exec -u vibe "$acceptance_container" vibestack-check --display --restart --automation
  docker cp "$REPO_ROOT/tests/runtime_service_check.py" \
    "$acceptance_container:/tmp/vibestack-runtime-service-check.py"
  docker exec "$acceptance_container" python3 /tmp/vibestack-runtime-service-check.py
  [[ "$(docker exec "$acceptance_container" /usr/bin/stat -c '%u:%g' \
      /projects/ownership-sentinel)" == "$project_owner" ]] || {
    echo "acceptance failed: the /projects sentinel ownership changed" >&2
    return 1
  }

  copy_onboarding_probe
  docker exec -i "$acceptance_container" \
    python3 /tmp/vibestack-runtime-onboarding-check.py configure \
    < "$acceptance_password_file"

  # A replacement container starts again from the immutable image while using
  # the same exact persistent state. This proves hash restoration and proves
  # that ad-hoc apt installs are intentionally container-local.
  docker rm -f "$acceptance_container" >/dev/null
  start_acceptance_container
  wait_for_health "$acceptance_container"
  copy_onboarding_probe
  docker exec -i "$acceptance_container" \
    python3 /tmp/vibestack-runtime-onboarding-check.py verify-restored \
    < "$acceptance_password_file"

  # Exercise all durable acceptance routes. Their saved selection, exact
  # probes, retired UI routes, Flatpak sandbox, and Godot's real X11 editor must
  # all work before the container is replaced.
  docker exec -u vibe "$acceptance_container" \
    vibestack-setup install godot build-essential flatpak
  # Install one real stable-Flathub GUI only in the disposable state. This
  # proves repository download, export discovery, inner sandbox launch, and
  # persistence across the second image replacement.
  docker exec -u vibe "$acceptance_container" \
    /usr/bin/env HOME=/home/vibe USER=vibe LOGNAME=vibe \
      XDG_DATA_HOME=/home/vibe/.local/share \
      /usr/bin/flatpak --user install --noninteractive --no-static-deltas \
        flathub org.gnome.Calculator
  docker exec "$acceptance_container" \
    python3 /tmp/vibestack-runtime-onboarding-check.py catalog-installed
  docker exec -u vibe "$acceptance_container" vibestack-check --live

  # Replace the container a second time after the catalog selection and Godot
  # sentinels are durable. The in-container probe waits boundedly for the setup
  # service's automatic reinstall, then rechecks the password, both catalog
  # probes, both persistent directories, and a real Godot editor window.
  docker rm -f "$acceptance_container" >/dev/null
  start_acceptance_container
  wait_for_health "$acceptance_container"
  copy_onboarding_probe
  docker exec -i "$acceptance_container" \
    python3 /tmp/vibestack-runtime-onboarding-check.py \
      verify-catalog-restored "$ACCEPTANCE_RESTORE_TIMEOUT_SECONDS" \
    < "$acceptance_password_file"
  docker exec -u vibe "$acceptance_container" vibestack-check --live

  docker cp "$acceptance_container:/data/vibestack/acceptance-owner.token" \
    "$acceptance_password_dir/browser.token"
  chmod 0600 "$acceptance_password_dir/browser.token"
  (cd "$REPO_ROOT" && \
    VIBESTACK_MCP_BASE_URL="http://127.0.0.1:${ACCEPTANCE_PORT}" \
    VIBESTACK_MCP_CREDENTIAL_FILE="$acceptance_password_dir/browser.token" \
    node tests/mcp-client-check.mjs)
  (cd "$REPO_ROOT" && \
    VIBESTACK_MCP_BASE_URL="http://127.0.0.1:${ACCEPTANCE_PORT}" \
    VIBESTACK_MCP_CREDENTIAL_FILE="$acceptance_password_dir/browser.token" \
    go run ./tests/mcp-client)
  # Disposable probe binary: avoid embedding unrelated parent-repository VCS
  # metadata when this checkout is an isolated worktree or exported source tree.
  (cd "$REPO_ROOT" && go build -buildvcs=false -o "$acceptance_password_dir/vibestack" ./cmd/vibestack)
  (cd "$REPO_ROOT" && \
    VIBESTACK_MCP_BASE_URL="http://127.0.0.1:${ACCEPTANCE_PORT}" \
    VIBESTACK_MCP_CREDENTIAL_FILE="$acceptance_password_dir/browser.token" \
    VIBESTACK_MCP_CLI="$acceptance_password_dir/vibestack" \
    VIBESTACK_ALLOW_MUTATING_MCP_TESTS=1 node tests/mcp-stdio-check.mjs)
  (cd "$REPO_ROOT" && \
    VIBESTACK_GUIDE_URL="http://127.0.0.1:${ACCEPTANCE_PORT}/AGENTS.md" \
    VIBESTACK_MCP_CREDENTIAL_FILE="$acceptance_password_dir/browser.token" \
    VIBESTACK_MCP_CLI="$acceptance_password_dir/vibestack" \
    node tests/agent-bootstrap-check.mjs)
  docker exec -u vibe "$acceptance_container" vibestack-service credential create \
    --label disposable-parity-summary --capabilities project_summary --expires-in 4h \
    --output /data/vibestack/acceptance-summary.token
  docker cp "$acceptance_container:/data/vibestack/acceptance-summary.token" \
    "$acceptance_password_dir/summary.token"
  chmod 0600 "$acceptance_password_dir/summary.token"
  (cd "$REPO_ROOT" && \
    VIBESTACK_MCP_BASE_URL="http://127.0.0.1:${ACCEPTANCE_PORT}" \
    VIBESTACK_MCP_CREDENTIAL_FILE="$acceptance_password_dir/browser.token" \
    VIBESTACK_PARITY_SCOPED_FILE="$acceptance_password_dir/summary.token" \
    VIBESTACK_MCP_CLI="$acceptance_password_dir/vibestack" \
    VIBESTACK_EXTENSION_CONTAINER="$acceptance_container" \
    VIBESTACK_DISPOSABLE_EXTENSION_TEST=1 python3 tests/extension-authoring-check.py)
  (cd "$REPO_ROOT" && \
    VIBESTACK_MCP_BASE_URL="http://127.0.0.1:${ACCEPTANCE_PORT}" \
    VIBESTACK_MCP_CREDENTIAL_FILE="$acceptance_password_dir/browser.token" \
    VIBESTACK_PARITY_SCOPED_FILE="$acceptance_password_dir/summary.token" \
    VIBESTACK_MCP_CLI="$acceptance_password_dir/vibestack" \
    VIBESTACK_ALLOW_MUTATING_MCP_TESTS=1 node tests/capability-parity-check.mjs)
  (cd "$REPO_ROOT" && \
    VIBESTACK_MCP_BASE_URL="http://127.0.0.1:${ACCEPTANCE_PORT}" \
    VIBESTACK_MCP_CREDENTIAL_FILE="$acceptance_password_dir/browser.token" \
    VIBESTACK_MCP_CLI="$acceptance_password_dir/vibestack" \
    VIBESTACK_ALLOW_MUTATING_MCP_TESTS=1 node tests/mcp-recovery-check.mjs)
  (cd "$REPO_ROOT" && \
    VIBESTACK_MCP_BASE_URL="http://127.0.0.1:${ACCEPTANCE_PORT}" \
    VIBESTACK_MCP_CREDENTIAL_FILE="$acceptance_password_dir/browser.token" \
    VIBESTACK_MCP_CLI="$acceptance_password_dir/vibestack" \
    VIBESTACK_ALLOW_PROVIDER_TESTS=1 node tests/provider-runtime-check.mjs)
  if [[ -n "${VIBESTACK_LEGACY_CLI:-}" ]]; then
    (cd "$REPO_ROOT" && \
      VIBESTACK_COMPAT_CURRENT_CLI="$acceptance_password_dir/vibestack" \
      go test ./runner -run '^TestHistoricalCLIWithPrivateRunner$' -count=1)
  fi
  (cd "$REPO_ROOT" && \
    VIBESTACK_BASE_URL="http://127.0.0.1:${ACCEPTANCE_PORT}" \
    VIBESTACK_BROWSER_CREDENTIAL_FILE="$acceptance_password_dir/browser.token" \
    VIBESTACK_ALLOW_MUTATING_BROWSER_TESTS=1 npm run test:browser)
  provider_persistence() {
    docker cp "$REPO_ROOT/tests/provider-persistence-check.py" \
      "$acceptance_container:/tmp/vibestack-provider-persistence-check.py"
    docker exec -e VIBESTACK_DISPOSABLE_PROVIDER_MIGRATION=1 "$acceptance_container" \
      python3 /tmp/vibestack-provider-persistence-check.py "$1"
  }
  restored_providers() {
    (cd "$REPO_ROOT" && \
      VIBESTACK_MCP_BASE_URL="http://127.0.0.1:${ACCEPTANCE_PORT}" \
      VIBESTACK_MCP_CREDENTIAL_FILE="$acceptance_password_dir/browser.token" \
      VIBESTACK_MCP_CLI="$acceptance_password_dir/vibestack" \
      VIBESTACK_ALLOW_PROVIDER_TESTS=1 node tests/provider-runtime-check.mjs verify-restored)
  }
  provider_persistence prepare
  docker restart "$acceptance_container" >/dev/null
  wait_for_health "$acceptance_container"
  restored_providers
  provider_persistence verify
  # A platform stop can kill Docker before Xvfb removes its lock. Reproduce a
  # stale PID that is already live again on the next boot, in this fixture only.
  docker exec "$acceptance_container" python3 -c '
import os, stat
p="/tmp/.X0-lock"
s=os.lstat(p)
assert stat.S_ISREG(s.st_mode) and s.st_nlink == 1 and s.st_uid == 1000
# Do not use O_CREAT on another UID's file in a sticky directory: Linux
# protected_regular correctly rejects that even for this root-owned fixture.
fd=os.open(p, os.O_WRONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
try:
    opened=os.fstat(fd)
    assert (opened.st_dev, opened.st_ino) == (s.st_dev, s.st_ino)
    os.ftruncate(fd, 0)
    os.write(fd, b"         1\n")
finally:
    os.close(fd)
'
  docker kill --signal KILL "$acceptance_container" >/dev/null
  docker start "$acceptance_container" >/dev/null
  wait_for_health "$acceptance_container"
  restored_providers
  provider_persistence verify
  docker exec -u vibe "$acceptance_container" vibestack-check --live
  echo "PASS abrupt container restart clears stale display lock and preserves provider state"
  if [[ -n "${VIBESTACK_ROLLBACK_IMAGE:-}" ]]; then
    # Both images use only this invocation's disposable data/projects. The live
    # desktop is never inspected, retagged, stopped or mounted by this probe.
    docker image inspect "$VIBESTACK_ROLLBACK_IMAGE" >/dev/null
    local candidate_image="$image"
    rollback_probe() {
      (cd "$REPO_ROOT" && \
        VIBESTACK_MCP_BASE_URL="http://127.0.0.1:${ACCEPTANCE_PORT}" \
        VIBESTACK_MCP_CREDENTIAL_FILE="$acceptance_password_dir/browser.token" \
        VIBESTACK_ROLLBACK_SNAPSHOT="$acceptance_password_dir/rollback.json" \
        VIBESTACK_ALLOW_MUTATING_MCP_TESTS=1 node tests/rollback-check.mjs "$1")
    }
    rollback_probe prepare
    docker rm -f "$acceptance_container" >/dev/null
    image="$VIBESTACK_ROLLBACK_IMAGE"
    start_acceptance_container
    wait_for_health "$acceptance_container"
    copy_onboarding_probe
    docker exec -i "$acceptance_container" \
      python3 /tmp/vibestack-runtime-onboarding-check.py \
        verify-catalog-restored "$ACCEPTANCE_RESTORE_TIMEOUT_SECONDS" with-providers with-legacy-ui \
      < "$acceptance_password_file"
    rollback_probe previous
    provider_persistence verify
    docker exec -u vibe "$acceptance_container" vibestack-check --live
    docker rm -f "$acceptance_container" >/dev/null
    image="$candidate_image"
    start_acceptance_container
    wait_for_health "$acceptance_container"
    copy_onboarding_probe
    docker exec -i "$acceptance_container" \
      python3 /tmp/vibestack-runtime-onboarding-check.py \
        verify-catalog-restored "$ACCEPTANCE_RESTORE_TIMEOUT_SECONDS" with-providers \
      < "$acceptance_password_file"
    rollback_probe candidate
    restored_providers
    provider_persistence verify
    docker exec -u vibe "$acceptance_container" vibestack-check --live
  fi
)

service_log_path() {
  case "$1" in
    desktop) echo /data/logs/vibestack/services/xfce4.log ;;
    vnc) echo /data/logs/vibestack/services/x11vnc.log ;;
    novnc) echo /data/logs/vibestack/services/novnc.log ;;
    setup) echo /data/logs/vibestack/services/vibestack-setup.log ;;
    control) echo /data/logs/vibestack/services/vibestack-control.log ;;
    automation) echo /data/logs/vibestack/services/vibestack-automation.log ;;
    automation-audit) echo /data/logs/vibestack/automation-audit.jsonl ;;
    desktop-actions) echo /data/logs/vibestack/desktop/actions.jsonl ;;
    nginx) echo /data/logs/vibestack/nginx/error.log ;;
    nginx-access) echo /data/logs/vibestack/nginx/access.jsonl ;;
    xvfb) echo /data/logs/vibestack/services/xvfb.log ;;
    *)
      echo "unknown log '$1'; use desktop, vnc, novnc, setup, control, automation, automation-audit, desktop-actions, nginx, nginx-access, or xvfb" >&2
      return 2 ;;
  esac
}

command_name="${1:-help}"
shift || true
case "$command_name" in
  test)
    run_fast_tests ;;
  build)
    require docker
    selected_image="${1:-$IMAGE_NAME}"
    docker build -t "$selected_image" "$REPO_ROOT" ;;
  accept)
    run_acceptance "${1:-$IMAGE_NAME}" ;;
  browser)
    run_browser_tests "${1:-http://127.0.0.1:${HOST_PORT}}" ;;
  check)
    require docker
    docker exec -u vibe "$CONTAINER_NAME" vibestack-check --live ;;
  status)
    require docker
    docker ps -a --filter "name=^/${CONTAINER_NAME}$" --format '{{.Names}} {{.Status}} {{.Image}} {{.Ports}}'
    docker exec -u vibe "$CONTAINER_NAME" vibestack-check --live || true
    echo
    if command -v tailscale >/dev/null 2>&1; then
      tailscale serve status || true
    fi ;;
  logs)
    require docker
    if [[ $# -eq 0 ]]; then
      docker logs --tail 200 -f "$CONTAINER_NAME"
    else
      selected_log="$(service_log_path "$1")"
      docker exec "$CONTAINER_NAME" tail -n 200 -F "$selected_log"
    fi ;;
  shell)
    require docker
    docker exec -it -u vibe -e DISPLAY=:0 -e XAUTHORITY=/run/vibestack/Xauthority -e XDG_RUNTIME_DIR=/run/vibestack/runtime \
      "$CONTAINER_NAME" bash -lc \
      '[[ -f /run/vibestack/session.env ]] && source /run/vibestack/session.env; exec bash' ;;
  serve)
    require tailscale
    require curl
    require python3
    selected_https_port="${1:-$TAILSCALE_HTTPS_PORT}"
    [[ "$selected_https_port" =~ ^[0-9]{1,5}$ ]] && (( selected_https_port >= 1 && selected_https_port <= 65535 )) || {
      echo "invalid HTTPS port: $selected_https_port" >&2
      exit 2
    }
    expected_proxy="http://127.0.0.1:${HOST_PORT}"
    curl -fsS "${expected_proxy}/healthz" >/dev/null || {
      echo "VibeStack is not healthy at ${expected_proxy}; Serve was not changed" >&2
      exit 1
    }
    existing_proxy="$(tailscale serve status --json | python3 -c '
import json, sys
port = sys.argv[1]
data = json.load(sys.stdin)
for address, site in data.get("Web", {}).items():
    if address.rsplit(":", 1)[-1] != port:
        continue
    print(site.get("Handlers", {}).get("/", {}).get("Proxy", ""))
    break
' "$selected_https_port")"
    if [[ -n "$existing_proxy" && "$existing_proxy" != "$expected_proxy" ]]; then
      echo "refusing to replace existing Tailscale Serve port ${selected_https_port}: ${existing_proxy}" >&2
      exit 1
    fi
    tailscale serve --bg --https="$selected_https_port" "$expected_proxy"
    tailscale serve status ;;
  help|-h|--help)
    usage ;;
  *)
    echo "unknown command: $command_name" >&2
    usage >&2
    exit 2 ;;
esac
