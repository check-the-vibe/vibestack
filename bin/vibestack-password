#!/usr/bin/env python3
"""Root-only VibeStack password persistence and restore helper.

Only the Linux-compatible password hash is persisted.  The ``set`` command
accepts one bounded JSON object on stdin so plaintext never appears in argv,
process listings, service logs, or command output.
"""

from __future__ import annotations

import fcntl
import json
import os
import re
import secrets
import stat
import string
import subprocess
import sys


ACCOUNT = "vibe"
STATE_DIR = "/data/.vibestack-auth-v1"
HASH_NAME = "vibe.shadow"
LOCK_PATH = "/run/vibestack-password.lock"
OPENSSL = "/usr/bin/openssl"
CHPASSWD = "/usr/sbin/chpasswd"
USERMOD = "/usr/sbin/usermod"

MIN_PASSWORD_BYTES = 12
MAX_PASSWORD_BYTES = 256
MAX_REQUEST_BYTES = 1024
MAX_HASH_BYTES = 256
MAX_SHADOW_BYTES = 1024 * 1024
SHA512_ROUNDS = 656_000
SALT_LENGTH = 16
SALT_ALPHABET = string.ascii_letters + string.digits + "./"
HASH_RE = re.compile(
    rb"\$6\$rounds=656000\$[./0-9A-Za-z]{16}\$[./0-9A-Za-z]{86}"
)
SAFE_ENV = {
    "HOME": "/root",
    "LANG": "C",
    "LC_ALL": "C",
    "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
}


class PasswordError(RuntimeError):
    """A deliberately non-secret-bearing password helper failure."""


class PasswordPolicyError(PasswordError):
    pass


def _directory_flags() -> int:
    try:
        return os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW
    except AttributeError as exc:  # Linux is the only supported runtime.
        raise PasswordError("required filesystem safeguards are unavailable") from exc


def _open_absolute_directory(path: str) -> int:
    normalized = os.path.normpath(path)
    if not os.path.isabs(path) or normalized != path or path == "/":
        raise PasswordError("password state path is invalid")
    current = os.open("/", _directory_flags())
    try:
        for component in normalized.split("/")[1:]:
            following = os.open(component, _directory_flags(), dir_fd=current)
            os.close(current)
            current = following
        return current
    except BaseException:
        os.close(current)
        raise


def _open_state_directory(
    state_dir: str = STATE_DIR, *, expected_uid: int = 0, expected_gid: int = 0
) -> int:
    parent_path, name = os.path.split(state_dir)
    if not parent_path or not name or name in (".", ".."):
        raise PasswordError("password state path is invalid")
    parent_fd = _open_absolute_directory(parent_path)
    try:
        directory_fd = os.open(name, _directory_flags(), dir_fd=parent_fd)
    except BaseException:
        os.close(parent_fd)
        raise
    try:
        info = os.fstat(directory_fd)
        current = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
        if (
            not stat.S_ISDIR(info.st_mode)
            or info.st_dev != os.fstat(parent_fd).st_dev
            or (info.st_dev, info.st_ino) != (current.st_dev, current.st_ino)
            or (info.st_uid, info.st_gid) != (expected_uid, expected_gid)
            or stat.S_IMODE(info.st_mode) != 0o700
        ):
            raise PasswordError("password state directory failed its safety check")
    except BaseException:
        os.close(directory_fd)
        os.close(parent_fd)
        raise
    os.close(parent_fd)
    return directory_fd


def _validated_hash_file(
    directory_fd: int,
    *,
    expected_uid: int,
    expected_gid: int,
) -> tuple[int, os.stat_result] | None:
    try:
        before = os.stat(HASH_NAME, dir_fd=directory_fd, follow_symlinks=False)
    except FileNotFoundError:
        return None
    if not stat.S_ISREG(before.st_mode):
        raise PasswordError("password hash failed its safety check")
    try:
        file_fd = os.open(
            HASH_NAME,
            os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW,
            dir_fd=directory_fd,
        )
    except OSError as exc:
        raise PasswordError("password hash could not be opened safely") from exc
    try:
        info = os.fstat(file_fd)
        current = os.stat(HASH_NAME, dir_fd=directory_fd, follow_symlinks=False)
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_dev != os.fstat(directory_fd).st_dev
            or info.st_nlink != 1
            or (info.st_dev, info.st_ino) != (before.st_dev, before.st_ino)
            or (info.st_dev, info.st_ino) != (current.st_dev, current.st_ino)
            or (info.st_uid, info.st_gid) != (expected_uid, expected_gid)
            or stat.S_IMODE(info.st_mode) != 0o600
            or info.st_size > MAX_HASH_BYTES
        ):
            raise PasswordError("password hash failed its safety check")
        return file_fd, info
    except BaseException:
        os.close(file_fd)
        raise


def read_hash(
    state_dir: str = STATE_DIR, *, expected_uid: int = 0, expected_gid: int = 0
) -> bytes | None:
    directory_fd = _open_state_directory(
        state_dir, expected_uid=expected_uid, expected_gid=expected_gid
    )
    try:
        opened = _validated_hash_file(
            directory_fd, expected_uid=expected_uid, expected_gid=expected_gid
        )
        if opened is None:
            return None
        file_fd, _info = opened
        try:
            data = os.read(file_fd, MAX_HASH_BYTES + 1)
        finally:
            os.close(file_fd)
    finally:
        os.close(directory_fd)
    if data.endswith(b"\n"):
        data = data[:-1]
    if not HASH_RE.fullmatch(data):
        raise PasswordError("password hash has an unsupported format")
    return data


def read_live_hash(
    shadow_path: str = "/etc/shadow",
    *,
    expected_uid: int = 0,
) -> bytes:
    """Read ``vibe``'s password field from a stable, root-owned shadow file."""

    flags = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
    try:
        shadow_fd = os.open(shadow_path, flags)
    except OSError as exc:
        raise PasswordError("live password state could not be read safely") from exc
    try:
        before = os.fstat(shadow_fd)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or before.st_uid != expected_uid
            or stat.S_IMODE(before.st_mode) & 0o137
            or before.st_size > MAX_SHADOW_BYTES
        ):
            raise PasswordError("live password state failed its safety check")
        chunks = []
        total = 0
        while True:
            chunk = os.read(shadow_fd, min(64 * 1024, MAX_SHADOW_BYTES + 1 - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
            if total > MAX_SHADOW_BYTES:
                raise PasswordError("live password state is too large")
        after = os.fstat(shadow_fd)
        current = os.stat(shadow_path, follow_symlinks=False)
        if (
            (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino)
            or (before.st_dev, before.st_ino) != (current.st_dev, current.st_ino)
            or before.st_size != after.st_size
            or before.st_mtime_ns != after.st_mtime_ns
            or before.st_ctime_ns != after.st_ctime_ns
            or (after.st_mode, after.st_uid, after.st_nlink)
            != (current.st_mode, current.st_uid, current.st_nlink)
        ):
            raise PasswordError("live password state changed while it was read")
    except BaseException:
        os.close(shadow_fd)
        raise
    os.close(shadow_fd)

    matches = []
    for line in b"".join(chunks).splitlines():
        fields = line.split(b":")
        if fields and fields[0] == ACCOUNT.encode("ascii"):
            if len(fields) != 9:
                raise PasswordError("live password entry has an unsupported format")
            matches.append(fields[1])
    if len(matches) != 1:
        raise PasswordError("live password entry is unavailable")
    return matches[0]


def _live_hash_matches(saved_hash: bytes | None, live_hash: bytes) -> bool:
    if saved_hash is None:
        return live_hash.startswith((b"!", b"*"))
    return secrets.compare_digest(saved_hash, live_hash)


def _require_live_hash(saved_hash: bytes | None) -> None:
    if not _live_hash_matches(saved_hash, read_live_hash()):
        raise PasswordError("persistent and live password state do not match")


def password_status(
    state_dir: str = STATE_DIR,
    *,
    expected_uid: int = 0,
    expected_gid: int = 0,
) -> bool:
    """Return configured state only when persistent and live state agree."""

    saved_hash = read_hash(
        state_dir, expected_uid=expected_uid, expected_gid=expected_gid
    )
    _require_live_hash(saved_hash)
    return saved_hash is not None


def _write_all(file_fd: int, data: bytes) -> None:
    view = memoryview(data)
    while view:
        written = os.write(file_fd, view)
        if written <= 0:
            raise PasswordError("password hash write failed")
        view = view[written:]


def write_hash(
    password_hash: bytes,
    state_dir: str = STATE_DIR,
    *,
    expected_uid: int = 0,
    expected_gid: int = 0,
) -> None:
    if not HASH_RE.fullmatch(password_hash):
        raise PasswordError("refusing an unsupported password hash")
    directory_fd = _open_state_directory(
        state_dir, expected_uid=expected_uid, expected_gid=expected_gid
    )
    temporary_name = ".vibe.shadow.%s.tmp" % secrets.token_hex(12)
    temporary_fd = -1
    try:
        existing = _validated_hash_file(
            directory_fd, expected_uid=expected_uid, expected_gid=expected_gid
        )
        if existing is not None:
            os.close(existing[0])
        temporary_fd = os.open(
            temporary_name,
            os.O_WRONLY
            | os.O_CREAT
            | os.O_EXCL
            | os.O_CLOEXEC
            | os.O_NOFOLLOW,
            0o600,
            dir_fd=directory_fd,
        )
        os.fchown(temporary_fd, expected_uid, expected_gid)
        os.fchmod(temporary_fd, 0o600)
        _write_all(temporary_fd, password_hash + b"\n")
        os.fsync(temporary_fd)
        os.close(temporary_fd)
        temporary_fd = -1
        os.replace(
            temporary_name,
            HASH_NAME,
            src_dir_fd=directory_fd,
            dst_dir_fd=directory_fd,
        )
        os.fsync(directory_fd)
    finally:
        if temporary_fd >= 0:
            os.close(temporary_fd)
        try:
            os.unlink(temporary_name, dir_fd=directory_fd)
        except FileNotFoundError:
            pass
        os.close(directory_fd)


def remove_hash(
    state_dir: str = STATE_DIR, *, expected_uid: int = 0, expected_gid: int = 0
) -> None:
    directory_fd = _open_state_directory(
        state_dir, expected_uid=expected_uid, expected_gid=expected_gid
    )
    try:
        opened = _validated_hash_file(
            directory_fd, expected_uid=expected_uid, expected_gid=expected_gid
        )
        if opened is None:
            return
        os.close(opened[0])
        os.unlink(HASH_NAME, dir_fd=directory_fd)
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def validate_password(password: object) -> bytes:
    if not isinstance(password, str):
        raise PasswordPolicyError("password must be a string")
    try:
        encoded = password.encode("utf-8", "strict")
    except UnicodeEncodeError:
        raise PasswordPolicyError("password is not valid UTF-8") from None
    if not MIN_PASSWORD_BYTES <= len(encoded) <= MAX_PASSWORD_BYTES:
        raise PasswordPolicyError("password length is outside the supported range")
    if password.isspace() or any(ord(character) < 0x20 or ord(character) == 0x7F for character in password):
        raise PasswordPolicyError("password contains unsupported control characters")
    return encoded


def hash_password(password: bytes) -> bytes:
    salt = "".join(secrets.choice(SALT_ALPHABET) for _ in range(SALT_LENGTH))
    secret_input = bytearray(password)
    secret_input.append(0x0A)
    try:
        result = subprocess.run(
            [
                OPENSSL,
                "passwd",
                "-6",
                "-stdin",
                "-salt",
                "rounds=%d$%s" % (SHA512_ROUNDS, salt),
            ],
            input=secret_input,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=15,
            check=False,
            env=SAFE_ENV,
        )
    except (OSError, subprocess.SubprocessError):
        raise PasswordError("password hashing failed") from None
    finally:
        for index in range(len(secret_input)):
            secret_input[index] = 0
    password_hash = result.stdout.strip()
    if result.returncode != 0 or not HASH_RE.fullmatch(password_hash):
        raise PasswordError("password hashing failed")
    return password_hash


def _run_account_command(argv: list[str], *, input_data: bytes | None = None) -> None:
    try:
        result = subprocess.run(
            argv,
            input=input_data,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=15,
            check=False,
            env=SAFE_ENV,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        raise PasswordError("account update failed") from exc
    if result.returncode != 0:
        raise PasswordError("account update failed")


def apply_hash(password_hash: bytes) -> None:
    # The hash, like the plaintext before hashing, stays off argv.  chpasswd's
    # encrypted-input mode changes only the fixed local account.
    _run_account_command(
        [CHPASSWD, "--encrypted"], input_data=ACCOUNT.encode("ascii") + b":" + password_hash + b"\n"
    )


def lock_account() -> None:
    _run_account_command([USERMOD, "--lock", ACCOUNT])


def set_password(
    password: object,
    state_dir: str = STATE_DIR,
    *,
    expected_uid: int = 0,
    expected_gid: int = 0,
) -> None:
    encoded = validate_password(password)
    password_hash = hash_password(encoded)
    previous_hash = read_hash(
        state_dir, expected_uid=expected_uid, expected_gid=expected_gid
    )
    # Establish a trustworthy rollback point before changing either copy.  All
    # CLI callers hold the operation lock while this comparison is performed.
    _require_live_hash(previous_hash)
    write_hash(
        password_hash,
        state_dir,
        expected_uid=expected_uid,
        expected_gid=expected_gid,
    )
    try:
        apply_hash(password_hash)
        if read_hash(
            state_dir, expected_uid=expected_uid, expected_gid=expected_gid
        ) != password_hash:
            raise PasswordError("persistent password verification failed")
        _require_live_hash(password_hash)
    except (PasswordError, OSError):
        # Roll back the live account first.  If persistence rollback then
        # fails, status detects the mismatch and boot restore converges to the
        # durable requested hash instead of silently restoring an older hash.
        try:
            if previous_hash is None:
                lock_account()
                _require_live_hash(None)
                remove_hash(
                    state_dir,
                    expected_uid=expected_uid,
                    expected_gid=expected_gid,
                )
            else:
                apply_hash(previous_hash)
                _require_live_hash(previous_hash)
                write_hash(
                    previous_hash,
                    state_dir,
                    expected_uid=expected_uid,
                    expected_gid=expected_gid,
                )
        except (PasswordError, OSError):
            pass
        raise PasswordError("password update failed") from None


def restore_password(
    state_dir: str = STATE_DIR,
    *,
    expected_uid: int = 0,
    expected_gid: int = 0,
) -> bool:
    password_hash = read_hash(
        state_dir, expected_uid=expected_uid, expected_gid=expected_gid
    )
    if password_hash is None:
        lock_account()
        _require_live_hash(None)
        return False
    apply_hash(password_hash)
    _require_live_hash(password_hash)
    return True


def _reject_duplicate_keys(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON key")
        result[key] = value
    return result


def read_set_request(stream) -> object:
    raw = stream.read(MAX_REQUEST_BYTES + 1)
    if not raw or len(raw) > MAX_REQUEST_BYTES:
        raise PasswordPolicyError("password request is not bounded")
    try:
        body = json.loads(
            raw.decode("utf-8", "strict"), object_pairs_hook=_reject_duplicate_keys
        )
    except (UnicodeDecodeError, ValueError, json.JSONDecodeError):
        raise PasswordPolicyError("password request is invalid") from None
    if not isinstance(body, dict) or set(body) != {"password"}:
        raise PasswordPolicyError("password request schema is invalid")
    return body["password"]


def _open_operation_lock(
    lock_path: str = LOCK_PATH, *, expected_uid: int = 0, expected_gid: int = 0
) -> int:
    flags = os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW
    try:
        lock_fd = os.open(lock_path, flags, 0o600)
    except OSError as exc:
        raise PasswordError("password operation lock is unavailable") from exc
    try:
        info = os.fstat(lock_fd)
        current = os.stat(lock_path, follow_symlinks=False)
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_nlink != 1
            or (info.st_dev, info.st_ino) != (current.st_dev, current.st_ino)
            or (info.st_uid, info.st_gid) != (expected_uid, expected_gid)
        ):
            raise PasswordError("password operation lock failed its safety check")
        os.fchown(lock_fd, expected_uid, expected_gid)
        os.fchmod(lock_fd, 0o600)
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
        return lock_fd
    except BaseException:
        os.close(lock_fd)
        raise


def _emit_status(configured: bool) -> None:
    sys.stdout.write(
        json.dumps(
            {"password_configured": bool(configured)}, separators=(",", ":")
        )
        + "\n"
    )
    sys.stdout.flush()


def main(argv: list[str]) -> int:
    if os.geteuid() != 0:
        print("vibestack-password: root privileges are required", file=sys.stderr)
        return 1
    if len(argv) != 1 or argv[0] not in ("status", "set", "restore"):
        print("vibestack-password: invalid command", file=sys.stderr)
        return 2
    lock_fd = -1
    try:
        lock_fd = _open_operation_lock()
        command = argv[0]
        if command == "set":
            # Replacing an existing password is intentionally allowed without
            # the previous password: setup is a trusted-Tailscale admin surface.
            set_password(read_set_request(sys.stdin.buffer))
            _emit_status(True)
        elif command == "restore":
            _emit_status(restore_password())
        else:
            _emit_status(password_status())
    except PasswordPolicyError:
        print("vibestack-password: password policy rejected the request", file=sys.stderr)
        return 2
    except (PasswordError, OSError):
        print("vibestack-password: operation failed safely", file=sys.stderr)
        return 1
    finally:
        if lock_fd >= 0:
            try:
                fcntl.flock(lock_fd, fcntl.LOCK_UN)
            finally:
                os.close(lock_fd)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
