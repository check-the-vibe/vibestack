# Host-side development defaults. Copy selected values into your shell or a
# local env file; scripts intentionally do not source files implicitly.
export VIBESTACK_IMAGE=vibestack:dev
export VIBESTACK_CONTAINER=vibestack
export VIBESTACK_BIND_ADDRESS=127.0.0.1
export VIBESTACK_PORT=8080
export VIBESTACK_DATA=../vibestack-data
export VIBESTACK_ACCEPTANCE_PORT=18080
export VIBESTACK_TAILSCALE_HTTPS_PORT=9443
export VIBESTACK_RESTORE_TIMEOUT_SECONDS=3600
export VIBESTACK_PIDS_LIMIT=1024
# Opt-in only: lets Flatpak's bubblewrap create nested namespaces and mounts.
export VIBESTACK_FLATPAK=0
