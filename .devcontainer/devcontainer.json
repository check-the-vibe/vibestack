{
  "name": "VibeStack Development",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.26.4"
    }
  },
  "forwardPorts": [
    8080
  ],
  "portsAttributes": {
    "8080": {
      "label": "VibeStack (private)",
      "onAutoForward": "openBrowser",
      "requireLocalPort": false,
      "protocol": "http"
    }
  },
  "runArgs": [
    "--shm-size=1g"
  ],
  "mounts": [
    "source=vibestack-runtime-${devcontainerId},target=/vibestack-runtime,type=volume"
  ],
  "remoteUser": "vscode",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        ".context/github-codespaces.md"
      ]
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y python3 && mountpoint -q /vibestack-runtime && sudo install -d -o vscode -g vscode -m 0750 /vibestack-runtime",
  "updateContentCommand": "npm ci && npx playwright install --with-deps chromium && python3 .devcontainer/codespaces.py prepare",
  "postStartCommand": "python3 .devcontainer/codespaces.py start",
  "waitFor": "onCreateCommand"
}
